LOG_BLOCK = 32768
LOG_HEADER = 7


def varint(buf, pos):
    result = shift = 0
    while True:
        b = buf[pos]
        pos += 1
        result |= (b & 0x7F) << shift
        if not b & 0x80:
            return result, pos
        shift += 7


def put_varint(n):
    out = bytearray()
    while n >= 0x80:
        out.append((n & 0x7F) | 0x80)
        n >>= 7
    out.append(n)
    return bytes(out)


def _crc32c_table():
    table = []
    for i in range(256):
        c = i
        for _ in range(8):
            c = (c >> 1) ^ 0x82F63B78 if c & 1 else c >> 1
        table.append(c)
    return table


CRC32C_TABLE = _crc32c_table()


def crc32c(data):
    c = 0xFFFFFFFF
    for b in data:
        c = CRC32C_TABLE[(c ^ b) & 0xFF] ^ (c >> 8)
    return c ^ 0xFFFFFFFF


def masked_crc(data):
    c = crc32c(data)
    return (((c >> 15) | (c << 17)) + 0xA282EAD8) & 0xFFFFFFFF


def snappy_decompress(buf):
    size, pos = varint(buf, 0)
    out = bytearray()
    while pos < len(buf):
        tag = buf[pos]
        pos += 1
        kind = tag & 3
        if kind == 0:
            n = tag >> 2
            if n >= 60:
                extra = n - 59
                n = int.from_bytes(buf[pos:pos + extra], "little")
                pos += extra
            n += 1
            out += buf[pos:pos + n]
            pos += n
            continue
        if kind == 1:
            length = ((tag >> 2) & 7) + 4
            offset = ((tag >> 5) << 8) | buf[pos]
            pos += 1
        elif kind == 2:
            length = (tag >> 2) + 1
            offset = int.from_bytes(buf[pos:pos + 2], "little")
            pos += 2
        else:
            length = (tag >> 2) + 1
            offset = int.from_bytes(buf[pos:pos + 4], "little")
            pos += 4
        start = len(out) - offset
        for i in range(length):
            out.append(out[start + i])
    if len(out) != size:
        raise ValueError("snappy size mismatch")
    return bytes(out)


def _read_block(data, offset, size):
    raw = data[offset:offset + size]
    return snappy_decompress(raw) if data[offset + size] == 1 else raw


def _block_entries(block):
    restarts = struct.unpack_from("<I", block, len(block) - 4)[0]
    limit = len(block) - 4 - 4 * restarts
    pos, key = 0, b""
    while pos < limit:
        shared, pos = varint(block, pos)
        unshared, pos = varint(block, pos)
        vlen, pos = varint(block, pos)
        key = key[:shared] + block[pos:pos + unshared]
        pos += unshared
        yield key, block[pos:pos + vlen]
        pos += vlen


def sstable_records(path):
    with open(path, "rb") as f:
        data = f.read()
    footer = data[-48:]
    _, p = varint(footer, 0)
    _, p = varint(footer, p)
    idx_off, p = varint(footer, p)
    idx_size, p = varint(footer, p)
    for _, handle in _block_entries(_read_block(data, idx_off, idx_size)):
        off, q = varint(handle, 0)
        size, _ = varint(handle, q)
        for ikey, value in _block_entries(_read_block(data, off, size)):
            if len(ikey) < 8:
                continue
            tag = struct.unpack("<Q", ikey[-8:])[0]
            yield ikey[:-8], tag >> 8, tag & 0xFF, value


def log_payloads(data):
    pos, pending = 0, None
    while pos + LOG_HEADER <= len(data):
        left = LOG_BLOCK - pos % LOG_BLOCK
        if left < LOG_HEADER:
            pos += left
            continue
        length, rtype = struct.unpack_from("<HB", data, pos + 4)
        payload = data[pos + LOG_HEADER:pos + LOG_HEADER + length]
        pos += LOG_HEADER + length
        if rtype == 1:
            yield payload
            pending = None
        elif rtype == 2:
            pending = payload
        elif rtype == 3 and pending is not None:
            pending += payload
        elif rtype == 4 and pending is not None:
            yield pending + payload
            pending = None


def log_records(path):
    with open(path, "rb") as f:
        data = f.read()
    for batch in log_payloads(data):
        if len(batch) < 12:
            continue
        seq, count = struct.unpack_from("<QI", batch, 0)
        p = 12
        for i in range(count):
            if p >= len(batch):
                break
            kind = batch[p]
            p += 1
            klen, p = varint(batch, p)
            key = batch[p:p + klen]
            p += klen
            value = b""
            if kind == 1:
                vlen, p = varint(batch, p)
                value = batch[p:p + vlen]
                p += vlen
            yield key, seq + i, kind, value


def manifest_last_sequence(ldir):
    try:
        with open(os.path.join(ldir, "CURRENT")) as f:
            name = f.read().strip()
        with open(os.path.join(ldir, name), "rb") as f:
            data = f.read()
    except OSError:
        return 0
    last = 0
    for rec in log_payloads(data):
        p = 0
        try:
            while p < len(rec):
                tag, p = varint(rec, p)
                if tag == 1:
                    n, p = varint(rec, p)
                    p += n
                elif tag in (2, 3, 9):
                    _, p = varint(rec, p)
                elif tag == 4:
                    v, p = varint(rec, p)
                    last = max(last, v)
                elif tag == 5:
                    _, p = varint(rec, p)
                    n, p = varint(rec, p)
                    p += n
                elif tag == 6:
                    _, p = varint(rec, p)
                    _, p = varint(rec, p)
                elif tag == 7:
                    for _ in range(3):
                        _, p = varint(rec, p)
                    for _ in range(2):
                        n, p = varint(rec, p)
                        p += n
                else:
                    break
        except IndexError:
            continue
    return last


def file_number(path):
    try:
        return int(os.path.basename(path).split(".")[0])
    except ValueError:
        return -1


def ls_read(ldir, keys):
    best, max_seq = {}, manifest_last_sequence(ldir)
    paths = glob.glob(os.path.join(ldir, "*.ldb")) + glob.glob(os.path.join(ldir, "*.log"))
    for path in paths:
        reader = sstable_records if path.endswith(".ldb") else log_records
        for key, seq, kind, value in reader(path):
            max_seq = max(max_seq, seq)
            if key in keys and (key not in best or seq > best[key][0]):
                best[key] = (seq, kind, value)
    return best, max_seq


def ls_decode(rec):
    if rec is None or rec[1] != 1 or not rec[2]:
        return None
    raw = rec[2]
    text = raw[1:].decode("latin-1") if raw[0] == 1 else raw[1:].decode("utf-16-le")
    return json.loads(text)


def ls_encode(obj):
    return b"\x01" + json.dumps(obj, separators=(",", ":"), ensure_ascii=True).encode("latin-1")


def ls_append_batch(log_path, seq, puts):
    batch = bytearray(struct.pack("<QI", seq, len(puts)))
    for key, value in puts:
        batch += b"\x01" + put_varint(len(key)) + key + put_varint(len(value)) + value
    pos = os.path.getsize(log_path)
    out, left, first = bytearray(), bytes(batch), True
    while True:
        room = LOG_BLOCK - pos % LOG_BLOCK
        if room < LOG_HEADER:
            out += b"\x00" * room
            pos += room
            room = LOG_BLOCK
        frag, left = left[:room - LOG_HEADER], left[room - LOG_HEADER:]
        end = not left
        rtype = (1 if end else 2) if first else (4 if end else 3)
        out += struct.pack("<IHB", masked_crc(bytes([rtype]) + frag), len(frag), rtype) + frag
        pos += LOG_HEADER + len(frag)
        first = False
        if end:
            break
    with open(log_path, "ab") as f:
        f.write(out)
        f.flush()
        os.fsync(f.fileno())


IDB_REL = os.path.join("IndexedDB", "https_claude.ai_0.indexeddb.leveldb")
IDB_PIN_NAME = "store:pin-state:dframe-starred-code".encode("utf-16-be")


def idb_parse(value):
    ver, p = varint(value, 0)
    if value[p] != 0xFF:
        return None
    _, p = varint(value, p + 1)
    if value[p] == 0xFE:
        p += 13
    if value[p] != 0xFF:
        return None
    _, p = varint(value, p + 1)
    tag = value[p]
    n, q = varint(value, p + 1)
    if tag == 0x22:
        text = value[q:q + n].decode("latin-1")
    elif tag == 0x63:
        text = value[q:q + n].decode("utf-16-le")
    else:
        return None
    return value[:p], json.loads(text)


def idb_pin_record(ddir):
    latest, max_seq = {}, manifest_last_sequence(ddir)
    paths = glob.glob(os.path.join(ddir, "*.ldb")) + glob.glob(os.path.join(ddir, "*.log"))
    for path in paths:
        reader = sstable_records if path.endswith(".ldb") else log_records
        for key, seq, kind, value in reader(path):
            max_seq = max(max_seq, seq)
            if IDB_PIN_NAME in key and (key not in latest or seq > latest[key][0]):
                latest[key] = (seq, kind, value)
    for key, (seq, kind, value) in latest.items():
        if kind != 1 or len(value) < 20:
            continue
        try:
            parsed = idb_parse(value)
        except Exception:
            continue
        if parsed and isinstance(parsed[1], dict) and isinstance(parsed[1].get("state"), dict):
            return key, parsed[0], parsed[1], max_seq
    return None


def idb_pin_list(ddir):
    try:
        rec = idb_pin_record(ddir)
    except Exception:
        return None
    ids = rec[2]["state"].get("starredIds") if rec else None
    return [x for x in ids if isinstance(x, str)] if isinstance(ids, list) else None


def sync_idb_pins(ddir, wanted, dry_run, now_ms=None):
    logs = sorted(glob.glob(os.path.join(ddir, "*.log")), key=file_number)
    if not logs:
        return 0
    try:
        rec = idb_pin_record(ddir)
    except Exception:
        return 0
    if rec is None:
        return 0
    key, prefix, obj, max_seq = rec
    if obj["state"].get("starredIds") == wanted:
        return 0
    obj["state"]["starredIds"] = list(wanted)
    if "updatedAt" in obj:
        obj["updatedAt"] = now_ms or int(time.time() * 1000)
    text = json.dumps(obj, separators=(",", ":"), ensure_ascii=True).encode("latin-1")
    value = prefix + b"\x22" + put_varint(len(text)) + text
    if dry_run:
        return 1
    fd = os.open(os.path.join(ddir, "LOCK"), os.O_RDWR | os.O_CREAT)
    try:
        try:
            fcntl.lockf(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return 0
        ls_append_batch(logs[-1], max_seq + 1, [(key, value)])
        fcntl.lockf(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)
    return 1


def app_pin_list(claude_dir):
    for reader, rel in ((idb_pin_list, IDB_REL), (ls_pin_list, os.path.join("Local Storage", "leveldb"))):
        found = reader(os.path.join(claude_dir, rel))
        if found is not None:
            return found
    return None


def ls_pin_list(ldir):
    try:
        best, _ = ls_read(ldir, (LS_STARRED,))
        obj = ls_decode(best.get(LS_STARRED))
    except Exception:
        return None
    if isinstance(obj, dict) and isinstance(obj.get("value"), list):
        return [x for x in obj["value"] if isinstance(x, str)]
    return None


def with_appended(order, wanted):
    return order + ["code:" + n for n in wanted if "code:" + n not in order]


def sync_local_storage_pins(ldir, wanted, dry_run, now_ms=None):
    logs = sorted(glob.glob(os.path.join(ldir, "*.log")), key=file_number)
    if not logs:
        return 0
    try:
        best, max_seq = ls_read(ldir, LS_PIN_KEYS)
        starred = ls_decode(best.get(LS_STARRED))
        slice_ = ls_decode(best.get(LS_SLICE))
        store = ls_decode(best.get(LS_STORE))
    except Exception:
        return 0
    stamp = now_ms or int(time.time() * 1000)
    puts = []
    if best.get(LS_STARRED) and not isinstance(starred, dict):
        return 0
    if not isinstance(starred, dict) or starred.get("value") != wanted:
        obj = dict(starred) if isinstance(starred, dict) else {"value": [], "tabId": ""}
        obj["value"], obj["timestamp"] = list(wanted), stamp
        puts.append((LS_STARRED, ls_encode(obj)))
    value = slice_.get("value") if isinstance(slice_, dict) else None
    if isinstance(value, dict) and isinstance(value.get("pinnedOrder"), list):
        order = with_appended(value["pinnedOrder"], wanted)
        if order != value["pinnedOrder"]:
            value["pinnedOrder"], slice_["timestamp"] = order, stamp
            puts.append((LS_SLICE, ls_encode(slice_)))
    state = store.get("state") if isinstance(store, dict) else None
    if isinstance(state, dict) and isinstance(state.get("pinnedOrder"), list):
        order = with_appended(state["pinnedOrder"], wanted)
        if order != state["pinnedOrder"]:
            state["pinnedOrder"] = order
            puts.append((LS_STORE, ls_encode(store)))
    if not puts:
        return 0
    if dry_run:
        return 1
    fd = os.open(os.path.join(ldir, "LOCK"), os.O_RDWR | os.O_CREAT)
    try:
        try:
            fcntl.lockf(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return 0
        ls_append_batch(logs[-1], max_seq + 1, puts)
        fcntl.lockf(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)
    return 1


def claude_running(ldir=None):
    lock_path = os.path.join(ldir or LS_DIR, "LOCK")
    try:
        fd = os.open(lock_path, os.O_RDWR)
    except OSError:
        return False
    try:
        fcntl.lockf(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return True
    finally:
        os.close(fd)
    return False


def sync_starred_list(folders, dry_run, claude_dir=None, ldir=None):
    """Make the live account's pin list in claude_desktop_config.json
    (preferences.epitaxyPrefs) match isStarred in its index files. The app
    seeds its sidebar pins from that list at launch. Returns 1 when the list
    changed, 0 when it already matched, Claude is running, or the file is
    missing or unexpected."""
    cdir = claude_dir or CLAUDE_DIR
    if claude_running(ldir or os.path.join(cdir, "Local Storage", "leveldb")):
        return 0
    try:
        with open(os.path.join(cdir, "config.json")) as f:
            acct = json.load(f).get("lastKnownAccountUuid") or ""
    except Exception:
        return 0
    starred, present, activity = set(), set(), {}
    for a, _, path in folders:
        if a != acct:
            continue
        for fp in glob.glob(os.path.join(path, "local_*.json")):
            name = os.path.basename(fp)[:-5]
            d = load(fp)
            present.add(name)
            activity[name] = max(activity.get(name, 0), d.get("lastActivityAt") or 0)
            if d.get("isStarred"):
                starred.add(name)
    if not present:
        return 0
    cfg_path = os.path.join(cdir, "claude_desktop_config.json")
    try:
        with open(cfg_path, encoding="utf-8") as f:
            raw = f.read()
        cfg = json.loads(raw)
        prefs = cfg["preferences"]["epitaxyPrefs"]
        current = prefs.get(STARRED_PREF, [])
        if not isinstance(current, list):
            return 0
    except Exception:
        return 0
    keep = [x for x in current if x in starred or x not in present]
    wanted = keep + sorted(starred - set(keep), key=lambda n: -activity.get(n, 0))
    order = None
    slice_ = prefs.get("dframe-local-slice")
    if isinstance(slice_, dict) and isinstance(slice_.get("pinnedOrder"), list):
        cur_order = slice_["pinnedOrder"]
        order = cur_order + ["code:" + n for n in wanted if "code:" + n not in cur_order]
        if order == cur_order:
            order = None
    ls_changed = sync_local_storage_pins(ldir or os.path.join(cdir, "Local Storage", "leveldb"),
                                         wanted, dry_run)
    ls_changed = sync_idb_pins(os.path.join(cdir, IDB_REL), wanted, dry_run) or ls_changed
    if wanted == current and order is None:
        return ls_changed
    if not dry_run:
        prefs[STARRED_PREF] = wanted
        if order is not None:
            slice_["pinnedOrder"] = order
        body = json.dumps(cfg, indent=2, ensure_ascii=False)
        if raw.endswith("\n"):
            body += "\n"
        try:
            tmp = cfg_path + ".tmp-ccmirror"
            with open(tmp, "w", encoding="utf-8") as f:
                f.write(body)
            shutil.copymode(cfg_path, tmp)
            os.replace(tmp, cfg_path)
        except OSError:
            return ls_changed
    return 1


def swivel_switch(now=None):
    state_path = os.path.join(SWIVEL_DIR, "state.json")
    try:
        age = (now or time.time()) - os.path.getmtime(state_path)
        with open(state_path) as f:
            state = json.load(f)
    except Exception:
        return None
    prev, active = state.get("previousProfile"), state.get("activeProfile")
    if not prev or prev == active or not 0 <= age <= SWIVEL_RUN_WINDOW:
        return None
    if claude_running(LS_DIR):
        return None
    snap = os.path.join(SWIVEL_DIR, "profiles", prev, "Claude")
    try:
        with open(os.path.join(snap, "config.json")) as f:
            acct = json.load(f).get("lastKnownAccountUuid") or ""
        with open(os.path.join(CLAUDE_DIR, "config.json")) as f:
            live = json.load(f).get("lastKnownAccountUuid") or ""
    except Exception:
        return None
    if not acct or acct == live:
        return None
    return snap, acct, live


def outgoing_pin_list(now=None):
    switch = swivel_switch(now)
    if not switch:
        return None
    snap, acct, _ = switch
    try:
        starred = app_pin_list(snap)
        if starred is None:
            with open(os.path.join(snap, "claude_desktop_config.json"), encoding="utf-8") as f:
                starred = json.load(f)["preferences"]["epitaxyPrefs"].get(STARRED_PREF)
    except Exception:
        return None
    if not isinstance(starred, list):
        return None
    return acct, {x for x in starred if isinstance(x, str)}


def sync_scheduled_tasks(switch, dry_run):
    if not switch or not switch[2] or not os.path.isfile(TASK_SYNC_SCRIPT):
        return 0, 0
    try:
        loader = importlib.machinery.SourceFileLoader("claude_scheduled_tasks_sync", TASK_SYNC_SCRIPT)
        module = types.ModuleType(loader.name)
        loader.exec_module(module)
        return module.switch_sync(switch[1], switch[2], dry_run), 0
    except KeyboardInterrupt:
        raise
    except BaseException as e:
        print(f"cc-mirror-sessions: scheduled task sync failed: {e!r}", file=sys.stderr)
        return 0, 1


def seed_starred_from_list(folder_files, folders, acct, starred, dry_run):
    seeded = 0
    for a, _, path in folders:
        if a != acct:
            continue
        for fn, d in folder_files[path].items():
            want = fn[:-5] in starred
            if bool(d.get("isStarred")) == want:
                continue
            d["isStarred"] = want
            seeded += 1
            if dry_run:
                continue
            fp = os.path.join(path, fn)
            try:
                mt = os.path.getmtime(fp)
                tmp = fp + ".tmp-pinseed"
                with open(tmp, "w") as f:
                    json.dump(d, f, separators=(",", ":"), ensure_ascii=False)
                os.replace(tmp, fp)
                os.utime(fp, (mt, mt))
            except OSError:
                continue
    return seeded


def main():
    ap = argparse.ArgumentParser(description="Unify Claude Code sidebars across accounts.")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--quiet", action="store_true")
    ap.add_argument("--prune", action="store_true",
                    help="also remove dead (transcript-pruned) session copies, keeping one in --dead-home "
                         "(off by default: the Claude app prunes these itself on load)")
    ap.add_argument("--dead-home", default=None, metavar="ORG",
                    help="org folder to keep dead (transcript-pruned) sessions in "
                         "(default: \"dead_home\" in ~/.claude/cc-mirror.json)")
    ap.add_argument("--exclude", action="append", default=[], metavar="UUID")
    ap.add_argument("--no-restore", action="store_true",
                    help="skip reviving dead sessions from the transcript archive")
    ap.add_argument("--no-flag-sync", action="store_true",
                    help="skip syncing isArchived/isStarred/title across accounts")
    ap.add_argument("--no-task-sync", action="store_true",
                    help="skip carrying scheduled tasks from the outgoing account on a Swivel switch")
    ap.add_argument("--archive", default=None, metavar="GLOB",
                    help="recursive glob for archived transcripts (default: \"archive\" "
                         "in ~/.claude/cc-mirror.json; no archive -> no revive step)")
    ap.add_argument("--version", action="version", version="cc-mirror-sessions %s" % __version__)
    args = ap.parse_args()
    cfg = load_config()
    if args.dead_home is None:
        args.dead_home = cfg.get("dead_home") or ""
    if args.archive is None:
        args.archive = cfg.get("archive") or ""
    args.archive = os.path.expanduser(args.archive)
    args.exclude = list(args.exclude) + [x for x in (cfg.get("exclude") or []) if x]

    if not os.path.isdir(BASE):
        print(f"No session store found at {BASE}", file=sys.stderr)
        return 1

    os.makedirs(os.path.dirname(LOCKFILE), exist_ok=True)
    lock_fd = open(LOCKFILE, "w")
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        if not args.quiet:
            print("Another run is in progress; skipping.")
        return 0

    labels = resolve_emails() if (args.list or not args.quiet) else {}
    folders = discover_folders(args.exclude)
    stems = transcript_stems()

    def label(acct, org):
        return labels.get(org) or labels.get(acct) or f"{acct[:8]}…/{org[:8]}…"

    def resolvable(d):
        cli = d.get("cliSessionId") or ""
        return bool(cli) and cli in stems

    if args.list:
        print("Claude Code account folders (openable / dead):\n")
        for acct, org, path in folders:
            datas = [load(f) for f in glob.glob(os.path.join(path, "local_*.json"))]
            ok = sum(1 for d in datas if resolvable(d))
            print(f"  {ok:4d} openable + {len(datas) - ok:4d} dead = {len(datas):4d}   {label(acct, org)}")
        return 0

    def rank(d):
        return d.get("lastActivityAt") or d.get("lastFocusedAt") or d.get("createdAt") or 0

    # Index every folder once.
    folder_files = {}   # path -> {filename: data}
    folder_clis = {}    # path -> set of non-empty cliSessionIds present in that folder
    fn_groups = {}      # filename -> {path: data}  (used only by --prune)
    for acct, org, path in folders:
        files, clis = {}, set()
        for fp in glob.glob(os.path.join(path, "local_*.json")):
            fn = os.path.basename(fp)
            d = load(fp)
            files[fn] = d
            fn_groups.setdefault(fn, {})[path] = d
            cli = d.get("cliSessionId") or ""
            if cli:
                clis.add(cli)
        folder_files[path] = files
        folder_clis[path] = clis

    seeded = 0
    if not args.no_flag_sync:
        outgoing = outgoing_pin_list()
        if outgoing:
            seeded = seed_starred_from_list(folder_files, folders, outgoing[0], outgoing[1], args.dry_run)

    tasks_synced = tasks_failed = 0
    if not args.no_task_sync:
        tasks_synced, tasks_failed = sync_scheduled_tasks(swivel_switch(), args.dry_run)

    # 0) Revive dead sessions whose transcript survives in the archive. Mutates
    #    `stems`, so the steps below treat revived sessions as openable and
    #    spread them to every account.
    revived = 0
    if not args.no_restore and args.archive:
        revived = restore_dead(folder_files, stems, args.archive, args.dry_run)

    canon = {}          # cliSessionId -> (rank, data, filename, src_path)  for OPENABLE sessions
    for path, files in folder_files.items():
        for fn, d in files.items():
            if resolvable(d):
                cli = d.get("cliSessionId") or ""
                r = rank(d)
                if cli not in canon or r > canon[cli][0]:
                    canon[cli] = (r, d, fn, os.path.join(path, fn))

    added = fixed = pruned = 0

    # 1) Mirror each OPENABLE session (keyed by its globally-unique cliSessionId) into every
    #    account missing it. local_<id> filenames are NOT unique across accounts, so on a
    #    filename collision fall back to a cli-derived name instead of clobbering.
    for cli, (r, data, fn, src) in canon.items():
        for acct, org, path in folders:
            if cli in folder_clis[path]:
                continue                                          # account already has this session
            existing = folder_files[path].get(fn)
            if existing is None:                                  # name free -> copy as-is
                if not args.dry_run:
                    shutil.copy2(src, os.path.join(path, fn))
                    folder_files[path][fn] = dict(data)           # flag-sync sees the new copy
                    folder_clis[path].add(cli)
                added += 1
            elif not (existing.get("cliSessionId") or ""):        # stale empty -> repair in place
                if not args.dry_run:
                    shutil.copy2(src, os.path.join(path, fn))
                    folder_files[path][fn] = dict(data)
                    folder_clis[path].add(cli)
                fixed += 1
            else:                                                 # name taken by a different session
                dst = os.path.join(path, "local_%s.json" % cli)
                if os.path.exists(dst):
                    continue
                if not args.dry_run:
                    body = dict(data)
                    body["sessionId"] = "local_%s" % cli          # keep file self-consistent
                    with open(dst, "w") as f:
                        json.dump(body, f)
                    os.utime(dst, (os.path.getmtime(src),) * 2)   # preserve sidebar ordering
                    folder_files[path]["local_%s.json" % cli] = body
                    folder_clis[path].add(cli)
                added += 1

    # 1.6) Sync mutable per-session state (isArchived, title) across every copy.
    #    The sidecar STATE holds each session's last-synced values (the merge base):
    #    a copy that differs from base is a user action, so the CHANGE propagates —
    #    archive and un-archive both work, no mtime guessing (the app rewrites these
    #    files on mere focus, so mtimes are noise). Bootstrap (no base, e.g. the
    #    pre-2026-08-05 backlog or a revived dead store): archived-anywhere wins;
    #    divergent titles prefer a manual rename, then the most recently active copy.
    flag_synced = retitled = t_retitled = state_synced = 0
    if not args.no_flag_sync:
        try:
            with open(STATE) as f:
                state = json.load(f)
        except Exception:
            state = {}
        groups = {}
        for path, files in folder_files.items():
            for fn, d in files.items():
                cli = d.get("cliSessionId") or ""
                if cli:
                    groups.setdefault(cli, []).append((path, fn, d))
        new_state = {}
        dirty = set()
        for cli, copies in groups.items():
            base = state.get(cli) or {}
            title_of = lambda d: d.get("title") or ""
            src_of = lambda d: d.get("titleSource") or "auto"
            act_of = lambda d: d.get("lastActivityAt") or d.get("createdAt") or 0

            flags = {}
            for key, on, off in (("isArchived", "archive", "un-archive"),
                                 ("isStarred", "pin", "unpin")):
                vals = {bool(d.get(key)) for _, _, d in copies}
                if len(vals) == 1:
                    flags[key] = vals.pop()
                    continue
                b = base.get(key)
                v = (not b) if isinstance(b, bool) else True
                for path, fn, d in copies:
                    if bool(d.get(key)) != v:
                        d[key] = v
                        dirty.add((path, fn))
                flags[key] = v
                flag_synced += 1
                if not args.quiet:
                    print("  %s everywhere: %r" % (on if v else off,
                                                   title_of(copies[0][2])[:60]))
            arch = flags["isArchived"]

            title = None
            tvals = {(title_of(d), src_of(d)) for _, _, d in copies}
            if len(tvals) > 1:
                bt = base.get("title")
                if bt is not None:
                    cands = [d for _, _, d in copies if title_of(d) != bt]
                else:
                    cands = [d for _, _, d in copies]
                if cands:
                    manual = [d for d in cands if src_of(d) == "manual"]
                    w = max(manual or cands, key=act_of)
                    title, tsrc = title_of(w), src_of(w)
                    for path, fn, d in copies:
                        if (title_of(d), src_of(d)) != (title, tsrc):
                            d["title"], d["titleSource"] = title, tsrc
                            dirty.add((path, fn))
                    retitled += 1
            elif tvals:
                title = next(iter(tvals))[0]

            # Transcript anchor (added 2026-08-12): the transcript's last
            # custom-title record is the newest intended title, account-agnostic
            # and append-only — it survives index wipes and app builds that skip
            # the index write (anthropics/claude-code#85794). Same change-vs-base
            # semantics as above: only a CHANGE in the transcript title since the
            # last sync propagates; bootstrap just records the base. Tails are
            # only re-read when the transcript mtime moved.
            tpath = stems.get(cli)
            tt, tmt = base.get("ttitle"), base.get("tmt")
            if tpath:
                try:
                    m = os.path.getmtime(tpath)
                except OSError:
                    m = None
                if m is not None and m != tmt:
                    tmt = m
                    read = transcript_title(tpath)
                    if read is not None:
                        tt = read
            if (tt is not None and base.get("ttitle") is not None
                    and tt != base["ttitle"] and tt != (title or "")):
                w = max((d for _, _, d in copies), key=act_of)
                tsrc = src_of(w)
                for path, fn, d in copies:
                    if (title_of(d), src_of(d)) != (tt, tsrc):
                        d["title"], d["titleSource"] = tt, tsrc
                        dirty.add((path, fn))
                title = tt
                t_retitled += 1
                if not args.quiet:
                    print("  transcript title everywhere: %r" % tt[:60])

            changed = False
            w = max((d for _, _, d in copies),
                    key=lambda d: (act_of(d), d.get("completedTurns") or 0))
            for path, fn, d in copies:
                if d is w or act_of(d) >= act_of(w):
                    continue
                for key in PROGRESS_KEYS:
                    if key in w and d.get(key) != w[key]:
                        d[key] = w[key]
                        dirty.add((path, fn))
                        changed = True

            sbase = base.get("settings") or {}
            srec = {}
            for key in SETTING_KEYS:
                hashes = [(value_hash(d.get(key)), d) for _, _, d in copies]
                if len({h for h, _ in hashes}) > 1:
                    cands = [d for h, d in hashes if h != sbase.get(key)] or [d for _, d in hashes]
                    v = max(cands, key=act_of).get(key)
                    for path, fn, d in copies:
                        if d.get(key) != v and not (v is None and key not in d):
                            d[key] = v
                            dirty.add((path, fn))
                    changed = True
                    srec[key] = value_hash(v)
                else:
                    srec[key] = hashes[0][0]
            if changed:
                state_synced += 1

            rec = {"isArchived": arch, "isStarred": flags["isStarred"], "settings": srec}
            if title is not None:
                rec["title"] = title
            if tt is not None:
                rec["ttitle"] = tt
            if tmt is not None:
                rec["tmt"] = tmt
            new_state[cli] = rec

        for path, fn in sorted(dirty):
            fp = os.path.join(path, fn)
            d = folder_files[path].get(fn)
            if d is None or args.dry_run:
                continue
            try:
                mt = os.path.getmtime(fp) if os.path.exists(fp) else None
                tmp = fp + ".tmp-flagsync"
                with open(tmp, "w") as f:
                    json.dump(d, f, separators=(",", ":"), ensure_ascii=False)
                os.replace(tmp, fp)
                if mt:
                    os.utime(fp, (mt, mt))        # keep per-account sidebar ordering
            except OSError:
                continue
        if not args.dry_run:
            try:
                tmp = STATE + ".tmp"
                with open(tmp, "w") as f:
                    json.dump(new_state, f)
                os.replace(tmp, STATE)
            except OSError:
                pass

    pin_list = 0
    if not args.no_flag_sync:
        pin_list = sync_starred_list(folders, args.dry_run)

    # 2) Optional cleanup: remove DEAD (transcript-pruned) sessions spread to non-home
    #    accounts. Off by default — the Claude app prunes these itself on load.
    if args.prune:
        home_path = next((p for a, o, p in folders if o == args.dead_home), None)
        for fn, copies in fn_groups.items():
            if any(resolvable(d) for d in copies.values()):
                continue                                          # openable somewhere -> not dead
            keep = home_path if home_path in copies else sorted(copies)[0]
            for path in list(copies):
                if path != keep:
                    if not args.dry_run:
                        try:
                            os.remove(os.path.join(path, fn))
                        except OSError:
                            pass
                    pruned += 1

    verb = "Would" if args.dry_run else ""
    summary = (f"added {added}, repaired {fixed}, revived {revived}, pruned {pruned}, "
               f"flag-synced {flag_synced}, retitled {retitled}, t-retitled {t_retitled}, "
               f"state-synced {state_synced}, pin-list {pin_list}, pin-seeded {seeded}, "
               f"tasks-synced {tasks_synced}, tasks-sync-failed {tasks_failed}")
    if args.quiet:
        if (added or fixed or pruned or revived or flag_synced or retitled or t_retitled or state_synced
                or pin_list or seeded or tasks_synced or tasks_failed):
            print(f"cc-mirror-sessions: {summary}")
    else:
        print(f"\n{(verb + ' ') if verb else ''}{'add/repair/prune' if verb else 'Done'}: {summary}\n")
        for acct, org, path in folders:
            files = glob.glob(os.path.join(path, "local_*.json"))
            ok = sum(1 for f in files if resolvable(load(f)))
            print(f"  {ok:4d} openable   {label(acct, org)}")
        if (added or fixed) and not args.dry_run:
            print("\nRestart the Claude app (⌘Q + reopen) to refresh the sidebar.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
